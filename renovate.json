{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all"
  ],
  "schedule": [
    "at any time"
  ],
  "semanticCommitType": "fix",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "groupName": "Rust core",
      "matchManagers": [
        "cargo",
        "rust-toolchain"
      ],
      "postUpgradeTasks": {
        "commands": [
          "./build.sh"
        ],
        "executionMode": "branch",
        "fileFilters": [
          "Sources/RusshFFI/RusshFFI.swift"
        ]
      }
    }
  ]
}
